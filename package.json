{
  "name": "nutritime-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Time-aware meal recommendations with a grounded local assistant.",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:mobile",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "seed": "tsx packages/catalog/seed.ts",
    "typecheck": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/mobile && tsc --noEmit -p packages/domain && tsc --noEmit -p packages/contracts && tsc --noEmit -p packages/catalog && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "build:server": "tsc -p apps/server/tsconfig.build.json",
    "build:web": "npm --workspace apps/mobile run build",
    "test:e2e": "npm --prefix e2e test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
