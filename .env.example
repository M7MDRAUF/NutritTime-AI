# NutriTime AI - server configuration (TSD 5.2)
# Copy to .env. Never commit .env.

PORT=4000

# AI lane
AI_ENABLED=true
AI_FAKE=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_CHAT_TIMEOUT_MS=30000
OLLAMA_EXPLANATION_TIMEOUT_MS=12000

# How long Ollama keeps the model resident.
# MUST carry a unit suffix: ms | s | m | h.
# A bare number is rejected at boot, because Ollama reads it as SECONDS -
# AI_KEEP_ALIVE=30 means 30 seconds, not 30 minutes, and the model would evict
# between questions, resurfacing as an ordinary timeout.
AI_KEEP_ALIVE=30m

# Build-time only (npm run seed). Not read by the running server.
# Path to the USDA FoodData Central supporting-data archive (TSD 7.4).
USDA_DATASET_PATH=
