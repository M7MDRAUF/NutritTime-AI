# dependencies
node_modules/

# Build OUTPUT. `build/` is greedy: it matches a `build` directory at ANY depth, which is how
# `apps/server/build/stagePackages.mjs` -- step 3 of `npm run build:server` -- went uncommitted
# while `git status` stayed clean and the local build kept working. Build TOOLING therefore
# lives in a `scripts/` directory (`scripts/dev.mjs`, `apps/server/scripts/stagePackages.mjs`),
# never under `build/`. Found by the P28 architecture audit, after the commit.
# build output
dist/
build/
.expo/
web-build/

# test + coverage
coverage/
playwright-report/
test-results/

# environment
.env
.env.local
.env.*.local

# session tooling (machine-local paths; do not commit)
.claude/

# editor / OS
.DS_Store
Thumbs.db
*.log

# scratch
tmp/

# USDA dataset. The archive lives outside the repository and is read via USDA_DATASET_PATH;
# this rule is defence against a future copy-paste dropping a 16 MB CSV into the tree.
*.csv

# TypeScript incremental build state. Produced by `tsc -b`, never an input: regenerated on
# demand and machine-specific, so committing it would put one machine every other machine must
# agree with into the tree. Added at P28 after `npx tsc -b` left one untracked.
*.tsbuildinfo
